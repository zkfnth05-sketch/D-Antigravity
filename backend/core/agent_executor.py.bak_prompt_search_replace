def decode_bytes(b: bytes) -> str:
    if not b:
        return ""
    for enc in ["cp949", "utf-8", "euc-kr"]:
        try:
            return b.decode(enc).strip()
        except Exception:
            pass
    return b.decode("latin1", errors="replace").strip()


